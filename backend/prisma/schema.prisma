generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String    @unique
  xp            Int       @default(0)
  level         Int       @default(1)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudiedAt DateTime?
  createdAt     DateTime  @default(now())

  examSessions   ExamSession[]
  userBadges     UserBadge[]
  dailyGoals     DailyGoal[]
  domainProgress DomainProgress[]
}

model Question {
  id           String     @id @default(uuid())
  domain       Domain
  text         String
  options      Json
  correctIndex Int
  explanation  String
  source       String
  difficulty   Difficulty @default(MEDIUM)
  isApproved   Boolean    @default(true)
  createdAt    DateTime   @default(now())

  examAnswers ExamAnswer[]
}

model ExamSession {
  id               String    @id @default(uuid())
  userId           String
  mode             ExamMode
  domain           Domain?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  score            Int?
  totalTime        Int?
  timeLimitMinutes Int?

  user    User         @relation(fields: [userId], references: [id])
  answers ExamAnswer[]
}

model ExamAnswer {
  id                String  @id @default(uuid())
  sessionId         String
  questionId        String
  userAnswer        Int
  isCorrect         Boolean
  timeSpent         Int
  claudeExplanation String?

  session  ExamSession @relation(fields: [sessionId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])
}

model DomainProgress {
  id            String @id @default(uuid())
  userId        String
  domain        Domain
  totalAnswered Int    @default(0)
  totalCorrect  Int    @default(0)
  xpEarned      Int    @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, domain])
}

model Badge {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String
  domain      Domain?
  condition   Json

  userBadges UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@id([userId, badgeId])
}

model QuestionExplanation {
  id          String   @id @default(uuid())
  questionId  String   @unique
  content     String
  createdAt   DateTime @default(now())
}

model DailyGoal {
  id                 String   @id @default(uuid())
  userId             String
  date               DateTime @db.Date
  questionsTarget    Int      @default(10)
  questionsCompleted Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

enum Domain {
  AGENTIC_ARCHITECTURE
  TOOL_MCP_INTEGRATION
  CLAUDE_CODE_WORKFLOWS
  PROMPT_ENGINEERING
  CONTEXT_MANAGEMENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamMode {
  PRACTICE
  FULL_EXAM
  REVIEW
}
