    "neutral": {
      "50":  { "value": "#f9fafb", "role": "page-bg" },
      "100": { "value": "#f3f4f6", "role": "track-bg, disabled-option-bg" },
      "200": { "value": "#e5e7eb", "role": "border-default" },
