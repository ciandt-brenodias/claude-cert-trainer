      },
      "warning": {
        "bg":        { "value": "#fffbeb", "tailwind": "amber-50" },
        "text":      { "value": "#d97706", "tailwind": "amber-600" }
      },
      "passed": {
        "bg":        { "value": "#ecfdf5", "tailwind": "emerald-50" },
